#!/bin/bash

# omarchy:summary=Prompt for confirmation before starting a Noctra update

gum style --border normal --padding "1 2" \
  "Ready to update?" \
  "" \
  "• You cannot stop the update once you start!" \
  "• Make sure you're connected to power or have a full battery" \
  "" \
  "What's new: https://github.com/basecamp/omarchy/releases (upstream Omarchy changelog until Noctra releases are published)"

echo

if ! gum confirm "Continue with update?"; then
  echo "Update cancelled"
  exit 1
fi
